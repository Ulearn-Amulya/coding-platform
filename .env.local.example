# Copy this file to .env.local and replace the placeholders.
# Do not put real keys in this example file.
#
# In the Supabase dashboard, open your project, then Connect.
# Copy the Project URL and the publishable key (it starts with sb_publishable_).
# The same values are under Project Settings, then API Keys.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional. Python runs through Judge0 CE when these are unset.
# Use a server-only key if you switch to your own Judge0 instance.
# Do not prefix either name with NEXT_PUBLIC_.
# JUDGE0_API_URL=https://ce.judge0.com
# JUDGE0_API_KEY=
